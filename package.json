{
  "name": "@anephenix/changelog-generator",
  "version": "0.0.1",
  "description": "A utility for generating changelog updates from git history.",
  "husky": {
    "hooks": {
      "pre-commit": "npm run format && npm run build && npm run size && npm test"
    }
  },
  "typings": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "scripts": {
    "analyze": "size-limit --why",
    "build": "tsc --project tsconfig.json",
    "cover": "cross-env NODE_ENV=test npx nyc --reporter=lcov npm t",
    "format": "npx @biomejs/biome check src test --write",
    "lint": "npx @biomejs/biome check src test",
    "prepare": "husky",
    "size": "size-limit",
    "test": "cross-env NODE_ENV=test vitest --run",
    "watch": "tsc -w"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "10 KB"
    }
  ],
  "keywords": [
    "changelog"
  ],
  "author": "Paul Jensen",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@size-limit/esbuild-why": "^11.1.6",
    "@size-limit/preset-small-lib": "^11.1.6",
    "@types/node": "^22.7.4",
    "@vitest/coverage-v8": "^2.0.0",
    "cross-env": "^7.0.3",
    "husky": "^9.1.6",
    "size-limit": "^11.1.6",
    "size-limit-node-esbuild": "^0.3.0",
    "typescript": "^5.6.2",
    "vitest": "^2.0.0"
  }
}
